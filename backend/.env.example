# Pinned Aegra CLI runtime config
AUTH_TYPE=noop
PORT=4242

# PostgreSQL (managed by aegra dev — do not change unless you know what you're doing)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aegra
POSTGRES_PORT=4243

# LLM provider — set ONE of the sections below:

# Option A — OpenAI (cloud):
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Option B — Ollama (local, free):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3

# n8n integration — requires a running n8n instance (see n8n/ folder or README)
# Get your API key from: http://localhost:4245 → Settings → n8n API → Create API key
MCP_SERVER_URL=http://localhost:4244
MCP_AUTH_TOKEN=dev-token
N8N_WEB_URL=http://localhost:4245
# N8N_API_URL is passed to the n8n-mcp container — uses host.docker.internal to reach n8n from Docker
N8N_API_URL=http://host.docker.internal:4245/api/v1
N8N_API_KEY=
